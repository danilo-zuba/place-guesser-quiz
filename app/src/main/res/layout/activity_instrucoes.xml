<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Instrucoes"
    android:background="#6676FC">


    <TextView
        android:id="@+id/txvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Instruções"
        android:textColor="#F9FFDB"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/svInstrucoes"
        android:layout_width="0dp"
        android:layout_height="500dp" app:layout_constraintBottom_toTopOf="@id/btnVoltarTelaPrincipal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txvTitulo"
        app:layout_constraintVertical_bias="0.331">
        <TextView
            android:id="@+id/txvDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="O Region Quiz é um jogo de conhecimentos geográficos sobre o Brasil. Seu objetivo é responder corretamente às perguntas sobre cidades, monumentos, paisagens e outros lugares brasileiros. Durante a partida, você encontrará diferentes tipos de desafios: identificar um lugar entre quatro imagens, responder a perguntas com alternativas ou avaliar afirmações como verdadeiras ou falsas. Leia cada pergunta com atenção, escolha sua resposta e confira o resultado. As respostas corretas aumentam sua pontuação. Tente acertar o máximo de questões possível!"
            android:textColor="#F9FFDB"
            android:textSize="35sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnVoltarTelaPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:text="  Voltar  "
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/svInstrucoes" />

</androidx.constraintlayout.widget.ConstraintLayout>